# Dravonix WhatsApp AI Platform — environment variables
# Copy to .env and fill in real values for your environment.
# Never commit a real .env file. See docs/setup/*.md for full setup guides.
#
# Values are validated at startup by packages/config/src/env.ts (zod schema).
# "Public" variables are safe for the browser bundle (apps/web, prefixed NEXT_PUBLIC_).
# Everything else is server/worker-only and must never be exposed to the client.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
# development | test | staging | production
APP_URL=http://localhost:3000
API_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Centralized platform branding (packages/config/src/branding.ts)
# Optional: overrides the default Dravonix Media brand values in code.
# ---------------------------------------------------------------------------
PLATFORM_PRODUCT_NAME="Dravonix WhatsApp AI Platform"
PLATFORM_SHORT_NAME="Dravonix AI"
PLATFORM_COMPANY_NAME="Dravonix Media"
PLATFORM_SUPPORT_EMAIL=Support@dravonixmedia.com
PLATFORM_WEBSITE_URL=https://dravonix.example

# ---------------------------------------------------------------------------
# Development-only options
# ---------------------------------------------------------------------------
# Enables the dev tenant selector UI. Must be false/unset outside development;
# packages/config/src/env.ts refuses to start with this true when APP_ENV=production.
DEV_TENANT_SELECTOR_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Never expose the service-role key to the browser or any NEXT_PUBLIC_ variable.
SUPABASE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (test number during Stage A)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_TEST_WABA_ID=
META_TEST_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0
# When unset, packages/whatsapp uses a MockWhatsAppProvider that logs sends instead
# of calling the Graph API — safe for local development without Meta credentials.

# ---------------------------------------------------------------------------
# Anthropic (Claude)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Set explicitly — never assume "whatever is latest". Verify against current
# Anthropic docs before production deployment. See docs/setup/ANTHROPIC_SETUP.md.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
# When ANTHROPIC_API_KEY is unset, packages/ai uses a MockAiProvider.

# ---------------------------------------------------------------------------
# ElevenLabs (Speech-to-Text / Text-to-Speech) -- default voice provider
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DEFAULT=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v1
# When ELEVENLABS_API_KEY is unset, packages/speech uses Mock STT/TTS providers.

# ---------------------------------------------------------------------------
# Google Cloud Speech -- available as an alternative provider, not wired in by
# default (see docs/architecture/adr-0005-speech-provider-architecture.md)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CREDENTIALS=
# JSON service-account credentials as a single-line string, or a secret reference
# in your deployment platform's secret manager. Never commit this file/value.
GOOGLE_STT_LOCATION=global
GOOGLE_TTS_VOICE_DEFAULT=en-US-Neural2-C

# ---------------------------------------------------------------------------
# Razorpay (billing — test mode during Stage A)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# test | live — packages/billing refuses RAZORPAY_MODE=live outside APP_ENV=production.

# ---------------------------------------------------------------------------
# Cloudflare R2 (tenant-scoped temporary audio / processed media)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dravonix-media-dev
# When unset, packages/storage uses an in-memory MockStorageProvider.

# ---------------------------------------------------------------------------
# Transactional email (client/team invitation delivery -- packages/email)
# ---------------------------------------------------------------------------
ZEPTOMAIL_API_TOKEN=
# EMAIL_API_KEY=  # transitional fallback name for ZEPTOMAIL_API_TOKEN -- see packages/config/src/env.ts
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="DRAIVA by Dravonix Media"
# When ZEPTOMAIL_API_TOKEN (or the transitional EMAIL_API_KEY) or
# EMAIL_FROM_ADDRESS is unset, invitation delivery falls back to the existing
# manual-copy-link flow via a MockEmailProvider -- safe for local development
# without a real transactional email account.

# ---------------------------------------------------------------------------
# Security / observability
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
# 32-byte key (base64) used to encrypt provider credentials at rest. Generate with:
#   openssl rand -base64 32
SENTRY_DSN=
